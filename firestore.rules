rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{userId} {
      // O ranking é público para leitura; somente o próprio usuário grava seu registro.
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'photoURL', 'score', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'score', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 1000
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100000000
        && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 1000
        && request.resource.data.score is int
        && request.resource.data.score > resource.data.score
        && request.resource.data.score <= 100000000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'score', 'updatedAt']);
      allow delete: if false;
    }
  }
}